---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="About — Suman"
      description="A little about this space."
    />
  </head>

  <body>
    <Header />

    <main class="about">
      <p class="eyebrow">ABOUT</p>

      <h1>
        A place to<br />
        <em>think out loud.</em>
      </h1>

      <div class="copy">
        <p>
          I'm Suman. I write about things I'm learning, questions I'm
          exploring, and ideas that stay with me.
        </p>

        <p>
          This website is deliberately simple. No particular destination —
          just a space to collect thoughts and make sense of them.
        </p>
      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
  }

  .about {
    max-width: 850px;
    margin: 0 auto;
    padding: 9rem 2rem 8rem;
  }

  .eyebrow {
    margin: 0 0 1.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    font-weight: 600;
    color: var(--gray);
  }

  h1 {
    margin: 0;
    font-size: clamp(3.5rem, 8vw, 7rem);
    line-height: 0.98;
    letter-spacing: -0.06em;
    font-weight: 500;
  }

  h1 em {
    font-family: Georgia, serif;
    font-weight: 400;
  }

  .copy {
    max-width: 560px;
    margin-top: 5rem;
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--gray);
  }

  .copy p {
    margin: 0 0 1.5rem;
  }

  @media (max-width: 600px) {
    .about {
      padding: 6rem 1.25rem 5rem;
    }

    .copy {
      margin-top: 3.5rem;
      font-size: 1.05rem;
    }
  }
</style>