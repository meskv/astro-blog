---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const categories = [
  ...new Set(
    posts
      .map((post) => post.data.category)
      .filter(Boolean)
  ),
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Writing — Suman"
      description="Writing, ideas and observations."
    />
  </head>

  <body>
    <Header />

    <main class="blog">

      <header class="page-header">
        <p class="eyebrow">WRITING</p>

        <h1>Things I've been<br /><em>thinking about.</em></h1>

        <p>
          Essays, notes, stories, questions and whatever else
          seems worth putting into words.
        </p>
      </header>

      <nav class="categories" aria-label="Blog categories">
        <a href="/blog/" class="active">All</a>

        {categories.map((category) => (
          <a href={`/blog/?category=${encodeURIComponent(category)}`}>
            {category}
          </a>
        ))}
      </nav>

      <section class="posts">

        {
          posts.map((post, index) => (
            <a
              href={`/blog/${post.id}/`}
              class="post"
              data-category={post.data.category || ''}
            >
              <div class="post-number">
                {String(index + 1).padStart(2, '0')}
              </div>

              <div class="post-info">

                <div class="post-meta">
                  <span>{post.data.category || 'Writing'}</span>
                  <span>·</span>
                  <span>
                    {post.data.pubDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric',
                    })}
                  </span>
                </div>

                <h2>{post.data.title}</h2>

                <p>{post.data.description}</p>

              </div>

              <span class="arrow">↗</span>
            </a>
          ))
        }

      </section>

    </main>

    <Footer />

    <script>
      const params = new URLSearchParams(window.location.search);
      const selected = params.get('category');

      if (selected) {
        document.querySelectorAll('.post').forEach((post) => {
          const category = post.getAttribute('data-category');

          if (category !== selected) {
            post.setAttribute('hidden', '');
          }
        });

        document.querySelectorAll('.categories a').forEach((link) => {
          if (link.textContent?.trim() === selected) {
            link.classList.add('active');
          } else {
            link.classList.remove('active');
          }
        });
      }
    </script>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
  }

  .blog {
    max-width: 1120px;
    margin: 0 auto;
    padding: 7rem 2rem 9rem;
  }

  .page-header {
    max-width: 850px;
    padding: 4rem 0 6rem;
  }

  .eyebrow {
    margin: 0 0 2rem;
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    color: var(--gray);
    font-weight: 600;
  }

  h1 {
    margin: 0;
    font-size: clamp(3.5rem, 8vw, 7rem);
    line-height: 0.94;
    letter-spacing: -0.06em;
    font-weight: 500;
  }

  h1 em {
    font-family: Georgia, serif;
    font-weight: 400;
  }

  .page-header p:last-child {
    max-width: 550px;
    margin-top: 2rem;
    color: var(--gray);
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--gray-light);
    border-bottom: 1px solid var(--gray-light);
  }

  .categories a {
    padding: 0.5rem 0.8rem;
    color: var(--gray);
    text-decoration: none;
    font-size: 0.8rem;
  }

  .categories a:hover,
  .categories a.active {
    color: inherit;
  }

  .posts {
    margin-top: 1rem;
  }

  .post {
    display: grid;
    grid-template-columns: 70px 1fr 40px;
    gap: 2rem;
    align-items: start;
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--gray-light);
    color: inherit;
    text-decoration: none;
  }

  .post:hover h2 {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .post[hidden] {
    display: none;
  }

  .post-number {
    color: var(--gray);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .post-meta {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.8rem;
    color: var(--gray);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .post h2 {
    margin: 0;
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    font-weight: 500;
  }

  .post-info p {
    max-width: 650px;
    margin: 1rem 0 0;
    color: var(--gray);
    line-height: 1.6;
  }

  .arrow {
    font-size: 1.3rem;
    transition: transform 0.2s ease;
  }

  .post:hover .arrow {
    transform: translate(3px, -3px);
  }

  @media (max-width: 950px) {
  .blog {
    padding: 5rem 1.5rem 7rem;
  }

  .page-header {
    padding: 3rem 0 5rem;
  }

  .post {
    grid-template-columns: 200px 1fr 30px;
    gap: 1.5rem;
  }

  .post-image {
    width: 200px;
    height: 145px;
  }

  .post h2 {
    font-size: 2rem;
  }
}

@media (max-width: 700px) {
  .blog {
    padding: 4rem 1.25rem 6rem;
  }

  .page-header {
    padding: 2rem 0 3.5rem;
  }

  .page-header h1 {
    font-size: clamp(3rem, 14vw, 4.5rem);
  }

  .categories {
    overflow-x: auto;
    flex-wrap: nowrap;

    margin-left: -0.25rem;
    margin-right: -0.25rem;

    padding-left: 0.25rem;
    padding-right: 0.25rem;

    scrollbar-width: none;
  }

  .categories::-webkit-scrollbar {
    display: none;
  }

  .categories a {
    flex-shrink: 0;
  }

  .post {
    grid-template-columns: 1fr;
    gap: 1rem;

    padding: 2rem 0;
  }

  .post-image {
    width: 100%;
    height: 230px;
  }

  .post h2 {
    font-size: 1.8rem;
  }

  .post-info p {
    font-size: 0.95rem;
  }

  .arrow {
    display: none;
  }
}

@media (max-width: 420px) {
  .post-image {
    height: 200px;
  }

  .page-header h1 {
    font-size: 3rem;
  }
}
</style>