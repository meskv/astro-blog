---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const latestPost = posts[0];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Suman — Notes, ideas & observations"
      description="A personal space for notes, ideas, learning and observations."
    />
  </head>

  <body>
    <Header />

    <main class="home">
      <section class="intro">
        <p class="eyebrow">NOTES • IDEAS • OBSERVATIONS</p>

        <h1>
          Thinking, learning,<br />
          <em>and writing along the way.</em>
        </h1>

        <p class="lead">
          A quiet corner of the internet for things worth thinking about.
        </p>
      </section>

      {
        latestPost && (
          <section class="latest">
            <div class="section-label">LATEST</div>

            <a href={`/blog/${latestPost.slug}/`} class="post">
              <div>
                <p class="date">
                  {latestPost.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </p>

                <h2>{latestPost.data.title}</h2>

                <p class="description">
                  {latestPost.data.description}
                </p>
              </div>

              <span class="arrow">↗</span>
            </a>
          </section>
        )
      }
    </main>

    <Footer />
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
  }

  .home {
    max-width: 980px;
    margin: 0 auto;
    padding: 9rem 2rem 7rem;
  }

  .intro {
    max-width: 820px;
  }

  .eyebrow,
  .section-label {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    font-weight: 600;
    color: var(--gray);
  }

  h1 {
    margin: 1.4rem 0 1.5rem;
    font-size: clamp(3.2rem, 7vw, 6.5rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
    font-weight: 500;
  }

  h1 em {
    font-family: Georgia, serif;
    font-weight: 400;
  }

  .lead {
    max-width: 500px;
    font-size: 1.2rem;
    line-height: 1.7;
    color: var(--gray);
  }

  .latest {
    margin-top: 9rem;
  }

  .section-label {
    margin-bottom: 1.5rem;
  }

  .post {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    padding: 2rem 0;
    border-top: 1px solid var(--gray-light);
    text-decoration: none;
    color: inherit;
  }

  .post:hover h2 {
    opacity: 0.6;
  }

  .date {
    margin: 0 0 0.7rem;
    color: var(--gray);
    font-size: 0.85rem;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    letter-spacing: -0.035em;
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .description {
    max-width: 600px;
    margin: 0.8rem 0 0;
    color: var(--gray);
    line-height: 1.6;
  }

  .arrow {
    font-size: 1.8rem;
    font-weight: 300;
  }

  @media (max-width: 600px) {
    .home {
      padding: 6rem 1.25rem 5rem;
    }

    .latest {
      margin-top: 6rem;
    }

    .post {
      align-items: flex-start;
    }

    .description {
      font-size: 0.95rem;
    }
  }
</style>