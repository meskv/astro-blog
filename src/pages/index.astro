---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const latestPost = posts[0];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Suman — Notes, ideas & observations"
      description="Notes on learning, ideas and things worth thinking about."
    />
  </head>

  <body>
    <Header />

    <main class="home">

      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">PERSONAL NOTES · IDEAS · OBSERVATIONS</p>

          <h1>
            Thinking about<br />
            <em>the things that matter.</em>
          </h1>

          <p class="intro">
            A small corner of the internet where I write,
            learn, question, and occasionally change my mind.
          </p>
        </div>

        <div class="hero-mark">
          <span>✳</span>
        </div>
      </section>

      {
        latestPost && (
          <section class="featured">
            <div class="section-heading">
              <span>FEATURED WRITING</span>
              <span>01</span>
            </div>

            <a
              href={`/blog/${latestPost.id}/`}
              class="featured-card"
            >
              <div class="featured-image">
                {latestPost.data.imageUrl ? (
                  <img
                    src={latestPost.data.imageUrl}
                    alt={latestPost.data.title}
                  />
                ) : (
                  <div class="image-placeholder">
                    <span>01</span>
                  </div>
                )}
              </div>

              <div class="featured-content">
                <p class="date">
                  {latestPost.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </p>

                <h2>{latestPost.data.title}</h2>

                <p>{latestPost.data.description}</p>

                <span class="read">READ ARTICLE ↗</span>
              </div>
            </a>
          </section>
        )
      }

      <section class="statement">
        <p>
          I like ideas that make you pause,
          questions that don't have immediate answers,
          and the slow process of understanding something properly.
        </p>
      </section>

    </main>

    <Footer />
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
  }

  .home {
    max-width: 1120px;
    margin: 0 auto;
    padding: 7rem 2rem 8rem;
  }

  .hero {
    min-height: 65vh;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4rem;
  }

  .hero-copy {
    max-width: 850px;
  }

  .eyebrow,
  .section-heading,
  .read {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    font-weight: 600;
  }

  .eyebrow {
    color: var(--gray);
    margin-bottom: 2rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(3.5rem, 8vw, 7.5rem);
    line-height: 0.94;
    letter-spacing: -0.065em;
    font-weight: 500;
  }

  h1 em {
    font-family: Georgia, serif;
    font-weight: 400;
  }

  .intro {
    max-width: 520px;
    margin-top: 2.5rem;
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--gray);
  }

  .hero-mark {
    width: 110px;
    height: 110px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border: 1px solid var(--gray-light);
    border-radius: 50%;
  }

  .hero-mark span {
    font-size: 2.5rem;
    font-weight: 300;
  }

  .featured {
    margin-top: 4rem;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--gray-light);
    color: var(--gray);
  }

  .featured-card {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    min-height: 420px;
    text-decoration: none;
    color: inherit;
  }

  .featured-image {
    overflow: hidden;
    background: #eee;
  }

  .featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .featured-card:hover .featured-image img {
    transform: scale(1.035);
  }

  .image-placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #eee, #ddd);
    color: #888;
    font-size: 4rem;
  }

  .featured-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 3rem;
    border: 1px solid var(--gray-light);
    border-left: 0;
  }

  .date {
    margin: 0 0 1.2rem;
    font-size: 0.8rem;
    color: var(--gray);
  }

  h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.045em;
    font-weight: 500;
  }

  .featured-content > p:not(.date) {
    max-width: 430px;
    margin: 1.5rem 0 2.5rem;
    line-height: 1.7;
    color: var(--gray);
  }

  .read {
    margin-top: auto;
  }

  .statement {
    max-width: 700px;
    margin: 10rem 0 0 auto;
  }

  .statement p {
    margin: 0;
    font-family: Georgia, serif;
    font-size: clamp(1.8rem, 3vw, 3rem);
    line-height: 1.35;
    letter-spacing: -0.025em;
  }

  @media (max-width: 700px) {
    .home {
      padding: 5rem 1.25rem;
    }

    .hero {
      min-height: auto;
      padding: 4rem 0 7rem;
    }

    .hero-mark {
      display: none;
    }

    .featured-card {
      display: block;
    }

    .featured-image {
      height: 260px;
    }

    .featured-content {
      border-left: 1px solid var(--gray-light);
      border-top: 0;
      padding: 2rem;
    }

    .statement {
      margin-top: 7rem;
    }
  }
</style>