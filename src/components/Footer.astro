---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">

    <div class="footer-brand">
      <p class="footer-title">Suman</p>
      <p class="footer-description">
        Notes, ideas & observations.
      </p>
    </div>

    <nav aria-label="Footer navigation">
      <a href="/blog/">Writing</a>
      <a href="/about/">About</a>
      <a href="/rss.xml">RSS</a>
    </nav>

    <p class="copyright">
      © {year}
    </p>

  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    padding: 4rem 2rem;

    border-top: 1px solid var(--gray-light);

    background: var(--background);
    color: var(--gray);
  }

  .footer-inner {
    max-width: 1120px;
    margin: 0 auto;

    display: grid;
    grid-template-columns: 1fr auto 1fr;

    align-items: end;

    gap: 2rem;
  }

  .footer-title {
    margin: 0;

    color: var(--foreground);

    font-size: 0.95rem;
    font-weight: 650;
  }

  .footer-description {
    margin: 0.4rem 0 0;

    font-size: 0.78rem;
  }

  nav {
    display: flex;
    gap: 1.5rem;
  }

  nav a {
    color: inherit;
    text-decoration: none;
    font-size: 0.78rem;
  }

  nav a:hover {
    color: var(--foreground);
  }

  .copyright {
    justify-self: end;

    margin: 0;

    font-size: 0.75rem;
  }

  @media (max-width: 700px) {
    .site-footer {
      margin-top: 4rem;
      padding: 3rem 1.25rem;
    }

    .footer-inner {
      grid-template-columns: 1fr;
      align-items: start;

      gap: 1.8rem;
    }

    nav {
      flex-wrap: wrap;
      gap: 1rem 1.5rem;
    }

    .copyright {
      justify-self: start;
    }
  }

  @media (max-width: 420px) {
    .site-footer {
      padding: 2.5rem 1.25rem;
    }
  }
</style>