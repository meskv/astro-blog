---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

const {
  title,
  description,
  pubDate,
  category,
  imageUrl,
  imageCredit,
  imageCreditUrl,
  readingTime = 1,
} = Astro.props;

const fallbackImage =
  'https://images.pexels.com/photos/417173/pexels-photo-417173.jpeg';

const heroImage = imageUrl || fallbackImage;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${title} — Suman`}
      description={description}
    />
  </head>

  <body>
    <Header />

    <main class="article">

      <header class="article-header">

        {category && (
          <a
            class="category"
            href={`/blog/?category=${encodeURIComponent(category)}`}
          >
            {category}
          </a>
        )}

        <h1>{title}</h1>

        {description && (
          <p class="description">{description}</p>
        )}

        <div class="meta">
          <FormattedDate date={pubDate} />
          <span>·</span>
          <span>{readingTime} min read</span>
        </div>

      </header>

      <figure class="hero">

        <img
          src={heroImage}
          alt={title}
          loading="eager"
        />

        {(imageCredit || imageCreditUrl) && (
          <figcaption>
            {imageCreditUrl ? (
              <a
                href={imageCreditUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                {imageCredit || 'Image source'}
              </a>
            ) : (
              imageCredit
            )}
          </figcaption>
        )}

      </figure>

      <article class="content">
        <slot />
      </article>

    </main>

    <Footer />
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
  }

  .article {
    max-width: 1120px;
    margin: 0 auto;
    padding: 7rem 2rem 9rem;
  }

  .article-header {
    max-width: 900px;
    margin: 0 auto 4rem;
  }

  .category {
    display: inline-block;
    margin-bottom: 1.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--gray);
    font-weight: 600;
  }

  .category:hover {
    color: inherit;
  }

  h1 {
    margin: 0;
    max-width: 900px;
    font-size: clamp(3.2rem, 8vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
    font-weight: 500;
  }

  .description {
    max-width: 720px;
    margin: 2rem 0 0;
    font-size: 1.25rem;
    line-height: 1.65;
    color: var(--gray);
  }

  .meta {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.8rem;
    font-size: 0.82rem;
    color: var(--gray);
  }

  .hero {
    margin: 0 0 5rem;
  }

  .hero img {
    display: block;
    width: 100%;
    max-height: 650px;
    object-fit: cover;
  }

  .hero figcaption {
    margin-top: 0.7rem;
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--gray);
  }

  .hero figcaption a {
    color: inherit;
  }

  .content {
    max-width: 680px;
    margin: 0 auto;
    font-size: 1.08rem;
    line-height: 1.85;
  }

  .content :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 3rem 0 0.6rem;
  }

  .content :global(p) {
    margin: 0 0 1.5rem;
  }

  .content :global(h2) {
    margin: 4rem 0 1.2rem;
    font-size: 2rem;
    line-height: 1.2;
    letter-spacing: -0.035em;
    font-weight: 500;
  }

  .content :global(h3) {
    margin: 3rem 0 1rem;
    font-size: 1.4rem;
  }

  .content :global(strong) {
    font-weight: 650;
  }

  .content :global(blockquote) {
    margin: 3rem 0;
    padding: 0 0 0 1.5rem;
    border-left: 2px solid currentColor;
    font-family: Georgia, serif;
    font-size: 1.35rem;
    line-height: 1.6;
  }

  .content :global(ul),
  .content :global(ol) {
    margin: 1.5rem 0;
    padding-left: 1.4rem;
  }

  .content :global(li) {
    margin: 0.6rem 0;
  }

  @media (max-width: 950px) {
  .article {
    padding: 5rem 1.5rem 7rem;
  }

  .article-header {
    max-width: 760px;
  }

  h1 {
    font-size: clamp(3.2rem, 8vw, 5.5rem);
  }

  .hero img {
    max-height: 520px;
  }
}

@media (max-width: 700px) {
  .article {
    padding: 4rem 1.25rem 6rem;
  }

  .article-header {
    margin-bottom: 2.5rem;
  }

  h1 {
    font-size: clamp(2.8rem, 13vw, 4.2rem);
    line-height: 0.98;
  }

  .description {
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .meta {
    font-size: 0.75rem;
  }

  .hero {
    margin-bottom: 3.5rem;
  }

  .hero img {
    max-height: 400px;
  }

  .content {
    font-size: 1rem;
    line-height: 1.8;
  }

  .content :global(h2) {
    font-size: 1.7rem;
  }

  .content :global(img) {
    margin-top: 2.5rem;
  }
}

@media (max-width: 420px) {
  .article {
    padding-left: 1rem;
    padding-right: 1rem;
  }

  h1 {
    font-size: 2.8rem;
  }

  .hero img {
    max-height: 330px;
  }
}
</style>