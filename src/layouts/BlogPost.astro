---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

const { title, description, pubDate } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${title} — Suman`}
      description={description}
    />
  </head>

  <body>
    <Header />

    <main class="article">
      <header class="article-header">
        <p class="eyebrow">ESSAY</p>

        <h1>{title}</h1>

        <p class="description">{description}</p>

        <div class="meta">
          <FormattedDate date={pubDate} />
          <span>·</span>
          <span>5 min read</span>
        </div>
      </header>

      <article class="content">
        <slot />
      </article>
    </main>

    <Footer />
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
  }

  .article {
    max-width: 900px;
    margin: 0 auto;
    padding: 8rem 2rem 8rem;
  }

  .article-header {
    max-width: 780px;
    margin-bottom: 6rem;
  }

  .eyebrow {
    margin: 0 0 1.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    font-weight: 600;
    color: var(--gray);
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 1;
    letter-spacing: -0.055em;
    font-weight: 500;
  }

  .description {
    max-width: 650px;
    margin: 2rem 0 0;
    font-size: 1.25rem;
    line-height: 1.65;
    color: var(--gray);
  }

  .meta {
    display: flex;
    gap: 0.6rem;
    margin-top: 2rem;
    font-size: 0.82rem;
    color: var(--gray);
  }

  .content {
    max-width: 680px;
    margin: 0 auto;
    font-size: 1.08rem;
    line-height: 1.85;
  }

  .content :global(h2) {
    margin: 4rem 0 1.2rem;
    font-size: 2rem;
    line-height: 1.2;
    letter-spacing: -0.035em;
    font-weight: 500;
  }

  .content :global(h3) {
    margin: 3rem 0 1rem;
    font-size: 1.4rem;
  }

  .content :global(p) {
    margin: 0 0 1.5rem;
  }

  .content :global(strong) {
    font-weight: 650;
  }

  .content :global(blockquote) {
    margin: 3rem 0;
    padding: 0 0 0 1.5rem;
    border-left: 2px solid currentColor;
    font-family: Georgia, serif;
    font-size: 1.35rem;
    line-height: 1.6;
  }

  .content :global(ul),
  .content :global(ol) {
    margin: 1.5rem 0;
    padding-left: 1.4rem;
  }

  .content :global(li) {
    margin: 0.6rem 0;
  }

  @media (max-width: 600px) {
    .article {
      padding: 6rem 1.25rem;
    }

    .article-header {
      margin-bottom: 4rem;
    }

    .description {
      font-size: 1.05rem;
    }

    .content {
      font-size: 1rem;
    }

    .content :global(h2) {
      font-size: 1.65rem;
      margin-top: 3rem;
    }
  }
</style>