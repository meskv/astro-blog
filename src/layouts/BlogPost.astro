---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

const {
  title,
  description,
  pubDate,
  category,
  imageUrl,
  imageCredit,
  imageCreditUrl,
  readingTime = 1,
} = Astro.props;

const fallbackImage =
  'https://images.pexels.com/photos/417173/pexels-photo-417173.jpeg';

const heroImage = imageUrl || fallbackImage;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${title} — Suman`}
      description={description}
      image={heroImage}
    />
  </head>

  <body>
    <Header />

    <main class="article">

      <header class="article-header">

        {category && (
          <a
            class="category"
            href={`/blog/?category=${encodeURIComponent(category)}`}
          >
            {category}
          </a>
        )}

        <h1>{title}</h1>

        {description && (
          <p class="description">{description}</p>
        )}

        <div class="meta">
          <FormattedDate date={pubDate} />
          <span>·</span>
          <span>{readingTime} min read</span>
        </div>

      </header>

      <figure class="hero">

        <img
          src={heroImage}
          alt={title}
          loading="eager"
        />

        {(imageCredit || imageCreditUrl) && (
          <figcaption>
            {imageCreditUrl ? (
              <a
                href={imageCreditUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                {imageCredit || 'Image source'}
              </a>
            ) : (
              imageCredit
            )}
          </figcaption>
        )}

      </figure>

      <article class="content">
        <slot />
      </article>

    </main>

    <Footer />
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
  }

  .article {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: 6rem 2rem 8rem;
    box-sizing: border-box;
  }

  .article-header {
    max-width: 820px;
    margin: 0 auto 3.5rem;
  }

  .category {
    display: inline-block;
    margin-bottom: 1.4rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--gray);
    font-weight: 650;
  }

  .category:hover {
    color: var(--foreground);
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 0.98;
    letter-spacing: -0.06em;
    font-weight: 500;
  }

  .description {
    max-width: 700px;
    margin: 1.8rem 0 0;
    font-size: 1.2rem;
    line-height: 1.65;
    color: var(--gray);
  }

  .meta {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.5rem;
    font-size: 0.8rem;
    color: var(--gray);
  }

  /* Hero */

  .hero {
    width: min(900px, 100%);
    margin: 0 auto 5rem;
  }

  .hero img {
    display: block;
    width: 100%;
    height: 500px;
    object-fit: cover;
    border-radius: 2px;
  }

  .hero figcaption {
    margin-top: 0.65rem;
    font-size: 0.7rem;
    line-height: 1.5;
    color: var(--gray);
  }

  .hero figcaption a {
    color: inherit;
  }

  /* Article */

  .content {
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
    font-size: 1.08rem;
    line-height: 1.85;
  }

  .content :global(p) {
    margin: 0 0 1.5rem;
  }

  .content :global(h2) {
    margin: 4rem 0 1.2rem;
    font-size: 2rem;
    line-height: 1.2;
    letter-spacing: -0.035em;
    font-weight: 550;
  }

  .content :global(h3) {
    margin: 3rem 0 1rem;
    font-size: 1.4rem;
    line-height: 1.3;
  }

  .content :global(strong) {
    font-weight: 650;
  }

  .content :global(a) {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  /* Images inside article */

  .content :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-height: 520px;
    object-fit: cover;
    margin: 3rem 0 0.65rem;
  }

  /* Image-credit paragraphs */

  .content :global(img + em) {
    display: block;
    margin: 0 0 2.5rem;
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--gray);
  }

  /* Lists */

  .content :global(ul),
  .content :global(ol) {
    margin: 1.5rem 0 2rem;
    padding-left: 1.4rem;
  }

  .content :global(li) {
    margin: 0.55rem 0;
  }

  /* Blockquotes */

  .content :global(blockquote) {
    margin: 3rem 0;
    padding: 0 0 0 1.5rem;
    border-left: 2px solid var(--foreground);
    font-family: Georgia, serif;
    font-size: 1.3rem;
    line-height: 1.6;
  }

  /* Inline code */

  .content :global(code) {
    padding: 0.15em 0.35em;
    border-radius: 4px;
    background: var(--surface);
    font-size: 0.88em;
  }

  /* Code blocks */

  .content :global(pre) {
    width: 100%;
    box-sizing: border-box;
    margin: 2rem 0 2.5rem;
    padding: 1.2rem 1.3rem;
    overflow-x: auto;
    border: 1px solid var(--gray-light);
    border-radius: 6px;
    background: var(--surface);
    font-size: 0.84rem;
    line-height: 1.65;
  }

  .content :global(pre code) {
    padding: 0;
    background: transparent;
    font-size: inherit;
  }

  /* Mathematics */

  .content :global(.katex-display) {
    margin: 2.5rem 0;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.5rem 0;
  }

  .content :global(.katex) {
    font-size: 1.05em;
  }

  /* Horizontal rule */

  .content :global(hr) {
    margin: 4rem 0;
    border: 0;
    border-top: 1px solid var(--gray-light);
  }

  /* Tablet */

  @media (max-width: 950px) {
    .article {
      padding: 5rem 1.5rem 7rem;
    }

    .hero img {
      height: 420px;
    }

    .article-header {
      max-width: 760px;
    }
  }

  /* Phone */

  @media (max-width: 700px) {
    .article {
      padding: 4rem 1.25rem 6rem;
    }

    .article-header {
      margin-bottom: 2.5rem;
    }

    h1 {
      font-size: clamp(2.7rem, 12vw, 4.2rem);
      line-height: 1;
    }

    .description {
      font-size: 1.05rem;
      line-height: 1.6;
    }

    .hero {
      margin-bottom: 3.5rem;
    }

    .hero img {
      height: 300px;
    }

    .content {
      font-size: 1rem;
      line-height: 1.8;
    }

    .content :global(h2) {
      font-size: 1.7rem;
      margin-top: 3.2rem;
    }

    .content :global(h3) {
      font-size: 1.3rem;
    }

    .content :global(img) {
      margin-top: 2.5rem;
      max-height: 380px;
    }

    .content :global(pre) {
      margin-left: -0.25rem;
      width: calc(100% + 0.5rem);
      font-size: 0.78rem;
    }

    .content :global(.katex-display) {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 420px) {
    .article {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .hero img {
      height: 240px;
    }
  }
</style>